(* One stored status, any number of writers. Each writer reads the status,  *)
(* picks a successor of what it read, and writes it. Guarded = TRUE checks  *)
(* the table against the status the write lands on; Guarded = FALSE checks  *)
(* it against the status the writer read earlier and writes by id.          *)
EXTENDS FiniteSets

CONSTANTS States, Initial, Succ, Writers, Guarded

ASSUME Initial \subseteq States
ASSUME \A s \in States : Succ[s] \subseteq States

Idle == "-"

VARIABLES status, seen
vars == <<status, seen>>

Init == /\ status \in Initial
        /\ seen = [w \in Writers |-> Idle]

Read(w) == /\ seen[w] = Idle
           /\ Succ[status] /= {}
           /\ seen' = [seen EXCEPT ![w] = status]
           /\ UNCHANGED status

Write(w) == /\ seen[w] /= Idle
            /\ \E t \in Succ[seen[w]] :
                 status' = IF Guarded
                             THEN IF t \in Succ[status] THEN t ELSE status
                             ELSE t
            /\ seen' = [seen EXCEPT ![w] = Idle]

Done == /\ \A w \in Writers : seen[w] = Idle
        /\ Succ[status] = {}
        /\ UNCHANGED vars

Next == Done \/ \E w \in Writers : Read(w) \/ Write(w)

Spec == Init /\ [][Next]_vars

TypeOK == /\ status \in States
          /\ \A w \in Writers : seen[w] \in States \cup {Idle}

Follows == [][status' \in Succ[status]]_status
