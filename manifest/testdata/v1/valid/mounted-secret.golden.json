{
  "sandbox": {
    "apiVersion": "cella.latere.ai/v1beta1",
    "kind": "Sandbox",
    "metadata": {
      "name": "with-a-secret"
    },
    "spec": {
      "environment": "default",
      "image": "registry.example/base:1",
      "command": [
        "/bin/sh",
        "-c",
        "sleep 60"
      ],
      "workdir": "/workspace",
      "resources": {
        "cpu": "1",
        "memory": "2Gi",
        "disk": "10Gi"
      },
      "workspace": {
        "path": "/workspace",
        "source": "empty"
      },
      "secrets": [
        {
          "name": "vendor",
          "env": "VENDOR_TOKEN"
        }
      ],
      "network": {
        "egress": {
          "mode": "allowlist"
        }
      },
      "lifecycle": {
        "autoStop": "15m",
        "ttl": "24h",
        "autoDelete": "72h"
      },
      "scheduling": {
        "queue": "default"
      }
    }
  },
  "secrets": [
    {
      "apiVersion": "cella.latere.ai/v1beta1",
      "kind": "Secret",
      "metadata": {
        "name": "vendor"
      },
      "spec": {
        "kind": "static",
        "scope": {
          "hosts": [
            "api.vendor.example"
          ]
        }
      },
      "status": {
        "id": "sec_01J0000000000000000000VEND",
        "owner": "https://issuer.example.com|alice",
        "version": 1,
        "createdAt": "0001-01-01T00:00:00Z",
        "mountedBy": 0
      }
    }
  ]
}
